<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee verification list view-->
    <record id="employee_verification_view_list" model="ir.ui.view">
        <field name="name">employee.verification.view.list</field>
        <field name="model">employee.verification</field>
        <field name="arch" type="xml">
            <list string="Employee Verification">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="agency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Employee verification form view-->
    <record id="employee_verification_view_form" model="ir.ui.view">
        <field name="name">employee.verification.view.form</field>
        <field name="model">employee.verification</field>
        <field name="arch" type="xml">
            <form string="Employee Verification">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assign,submit"/>
                    <button string="Assign to agency"
                            groups="hr.group_hr_manager"
                            type="object" name="action_assign_agency"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="address_id"
                                   readonly="state != 'draft'"/>
                            <field name="assigned_date"/>
                            <field name="expected_date"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="agency_id"
                                   readonly="state != 'draft'"/>
                            <field name="assigned_by_id"/>
                            <field name="resume_uploaded_ids"
                                   widget="many2many_binary"
                                   readonly="state != 'draft'" colspan="1"/>
                            <field name="field_check" invisible="1"/>
                        </group>
                    </group>
                    <notebook invisible="state != 'submit'">
                        <page name="agent" string="Information from Agency">
                            <group>
                                <button string=" Attachment"
                                        groups="hr.group_hr_manager"
                                        type="object"
                                        name="action_download_attachment"
                                        class="fa fa-download"/>
                            </group>
                            <group>
                                <field name="description_by_agency"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee verification search view-->
    <record id="employee_verification_view_search" model="ir.ui.view">
        <field name="name">employee.verification.view.search</field>
        <field name="model">employee.verification</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned"
                        domain="[('state', '=', 'assign')]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'submit')]"/>
                <!-- v18->v19: <separator/> and <group expand="0"> removed -->
                <filter string="Status" name="group_by_status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!--Sequence id for employee verification-->
    <record id="seq_ver_employee" model="ir.sequence">
        <field name="name">Employee Verification</field>
        <field name="code">employee.verification</field>
        <field name="prefix">EV</field>
        <field name="padding">6</field>
    </record>

    <!--Actions for menu items-->
    <record id="employee_verification_action" model="ir.actions.act_window">
        <field name="name">Employee Verification</field>
        <field name="res_model">employee.verification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="employee_verification_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new employee verification record.
            </p>
        </field>
    </record>

    <record id="assigned_employee_verification" model="ir.actions.act_window">
        <field name="name">Assigned Verification</field>
        <field name="res_model">employee.verification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'assign')]</field>
    </record>

    <record id="submitted_employee_verification" model="ir.actions.act_window">
        <field name="name">Submitted Verification</field>
        <field name="res_model">employee.verification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submit')]</field>
    </record>

    <record id="approved_employee_verification" model="ir.actions.act_window">
        <field name="name">Approved Verification</field>
        <field name="res_model">employee.verification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approve')]</field>
    </record>

    <record id="refused_employee_verification" model="ir.actions.act_window">
        <field name="name">Refused Verification</field>
        <field name="res_model">employee.verification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'refuse')]</field>
    </record>

    <!--Menu item for employee verification-->
    <menuitem id="employee_verification_menu"
              action="employee_verification_action"
              name="Verification"
              parent="hr.menu_hr_root"/>

</odoo>